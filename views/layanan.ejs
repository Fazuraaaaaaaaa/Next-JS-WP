<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= layanan ? layanan.title : 'Error' %> - M1 Ekosistem</title>
    <meta name="description" content="<%= layanan ? layanan.description : 'Layanan premium dari M1 Ekosistem.' %>">
    <meta property="og:title" content="<%= layanan ? layanan.title : 'Layanan' %> - M1 Ekosistem">
    <meta property="og:description" content="<%= layanan ? layanan.description : 'Layanan premium dari M1 Ekosistem.' %>">
    <meta property="og:type" content="website">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#0f172a',
                            900: '#0b1120',
                            950: '#020617',
                        },
                        electric: '#2563eb',
                        racing: '#dc2626',
                        silver: '#94a3b8',
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .glass-nav {
            background: rgba(11, 17, 32, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="bg-navy-950 text-gray-100 antialiased selection:bg-electric selection:text-white flex flex-col min-h-screen">

    <!-- Navbar: Sticky, Glassmorphism -->
    <nav class="fixed w-full z-50 top-0 transition-all duration-300 glass-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center">
                    <a href="/" class="text-3xl font-extrabold tracking-tighter text-white flex items-center gap-3">
                        <span>M<span class="text-electric">1</span></span>
                        <span class="text-base font-light tracking-[0.2em] text-silver uppercase border-l border-white/20 pl-3">Ekosistem</span>
                    </a>
                </div>
                <!-- Menu -->
                <div class="hidden md:flex space-x-10 items-center">
                    <a href="/" class="text-gray-300 hover:text-white font-medium transition-colors">Beranda</a>
                    <a href="/#layanan" class="text-white font-medium transition-colors border-b-2 border-electric pb-1">Layanan</a>
                    <a href="/berita" class="text-gray-300 hover:text-white font-medium transition-colors">Berita</a>
                    <a href="/tentang" class="text-gray-300 hover:text-white font-medium transition-colors">Tentang Kami</a>
                </div>
                <!-- CTA -->
                <div class="hidden md:flex items-center">
                    <a href="https://wa.me/6285647502098" target="_blank" class="bg-electric hover:bg-blue-700 text-white px-6 py-2.5 rounded-full font-semibold transition-all shadow-lg shadow-electric/25 hover:shadow-electric/40 hover:-translate-y-0.5">
                        Hubungi Kami
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow pt-32 pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full">
        <article class="bg-navy-900 rounded-3xl overflow-hidden shadow-2xl border border-white/5 relative">
            <div class="absolute top-0 right-0 w-64 h-64 bg-electric/10 rounded-bl-full pointer-events-none"></div>
            
            <% if (layanan) { %>
                <!-- Image Header -->
                <div class="w-full h-64 md:h-96 relative">
                    <img src="<%= layanan.image %>" alt="<%= layanan.title %>" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-900 to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8">
                        <h1 class="text-3xl md:text-5xl font-extrabold text-white drop-shadow-md"><%= layanan.title %></h1>
                    </div>
                </div>

                <!-- Content -->
                <div class="p-8 md:p-12 relative z-10">
                    <div class="prose prose-lg prose-invert max-w-none">
                        <p class="text-xl text-silver leading-relaxed font-light mb-8">
                            <%= layanan.description %>
                        </p>
                        
                        <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
                            <span class="w-8 h-8 rounded-full bg-electric/20 text-electric flex items-center justify-center">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </span>
                            Detail Layanan
                        </h3>
                        
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% layanan.details.forEach(detail => { %>
                                <li class="bg-navy-800/50 rounded-xl p-4 flex items-center gap-3 border border-white/5">
                                    <svg class="w-5 h-5 text-electric shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                                    <span class="text-gray-300 font-medium"><%= detail %></span>
                                </li>
                            <% }) %>
                        </ul>
                    </div>

                    <div class="mt-12 flex justify-center">
                        <a href="https://wa.me/6285647502098?text=Halo%20M1%20Ekosistem,%20saya%20tertarik%20dengan%20layanan%20<%= layanan.title %>" target="_blank" class="inline-flex items-center gap-3 bg-electric hover:bg-blue-600 text-white px-8 py-4 rounded-full font-bold transition-all shadow-lg shadow-electric/25 hover:shadow-electric/40 hover:-translate-y-1">
                            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                            Hubungi Kami
                        </a>
                    </div>
                </div>
            <% } else { %>
                <div class="p-12 text-center relative z-10">
                    <svg class="w-16 h-16 text-racing mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    <h2 class="text-2xl font-bold text-white mb-2">Oops!</h2>
                    <p class="text-silver"><%= error %></p>
                    <a href="/" class="mt-6 inline-block bg-white/10 hover:bg-white/20 text-white px-6 py-2.5 rounded-full font-semibold transition-colors">Kembali ke Beranda</a>
                </div>
            <% } %>
        </article>
    </main>

    <!-- Footer Consistent -->
    <%- include('partials/footer') %>
</body>
</html>
